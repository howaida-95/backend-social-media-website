
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },

  "paths": {
    "@/*": ["src/*"],
    "@config/*": ["src/config/*"],
    "@database/*": ["src/database/*"],  
    "@middlewares/*": ["src/middlewares/*"], 
    "@modules/*": ["src/modules/*"],
    "@routes/*": ["src/routes/*"],
    "@types/*": ["src/types/*"],
    "@utils/*": ["src/utils/*"],
    "@app/*": ["src/app/*"],
    "@server/*": ["src/server/*"]
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}